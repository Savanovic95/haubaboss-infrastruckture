# Copy to .env next to docker-compose.prod.yml and fill in.

MAIN_DOMAIN=unyielded.one
ACME_EMAIL=admin@unyielded.one

# Laravel
APP_KEY=base64:generate-with-php-artisan-key-generate

# Database
DB_DATABASE=haubaboss
DB_USERNAME=haubaboss
DB_PASSWORD=change-me

# S3 media storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=

# Optional
SENTRY_LARAVEL_DSN=
